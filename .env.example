# Copy to .env.local for local development. Never commit real secrets.

# Public site URL used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://syntram.com

# Show placeholder products and case studies in a production build
# (for preview deployments only). Placeholders are always noindexed and
# excluded from the sitemap. Defaults to false in production.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# Article content source: "local" (MDX files in /content, default) or "sanity".
CONTENT_SOURCE=local
# Required when CONTENT_SOURCE=sanity (see sanity/README.md)
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Server-only. Only needed for private datasets.
SANITY_READ_TOKEN=

# --- Leads (server-only) -------------------------------------------------
# PostgreSQL connection string. Without it, leads are delivered by email only.
DATABASE_URL=
# Random secret used to hash visitor IPs for rate limiting (raw IPs are never stored).
LEAD_IP_SALT=

# --- Email notifications via Resend (server-only) ------------------------
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Syntram Website <website@syntram.com>"
CONTACT_FROM_EMAIL=
# Comma-separated team inbox(es) that receive new enquiries
CONTACT_TO_EMAIL=

# --- Analytics (public; each integration is off unless set) --------------
# Scripts load only after the visitor accepts analytics cookies.
# Recommended: manage GA4 inside GTM and leave NEXT_PUBLIC_GA4_ID empty.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
# Google Search Console HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=
